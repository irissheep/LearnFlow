# scripts/init-env.ps1 会自动创建 .env 并生成随机密码与内部令牌。
MYSQL_DATABASE=learnflow
MYSQL_USER=learnflow_app
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
AI_SERVICE_TOKEN=replace-with-at-least-32-random-characters
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
COOKIE_SECURE=false
